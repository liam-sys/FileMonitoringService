{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore": "Critical",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },

  "ConnectionStrings": {
    "MonitoringDb": "Server=(localdb)\\MSSQLLocalDB;Database=FileMonitoringDb;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=5"
  },

  "FileMonitoring": {
    "Directories": [
      "C:\\MonitoredFolders\\Incoming",
      "C:\\MonitoredFolders\\Reports"
    ],
    "IncludeSubdirectories": true,
    "Filter": "*.*",
    "InternalBufferSizeKb": 64,
    "ChannelCapacity": 1000,
    "DuplicateWindowMs": 500,
    "MaxSaveAttempts": 3,
    "RetryBaseDelayMs": 1000
  }
}